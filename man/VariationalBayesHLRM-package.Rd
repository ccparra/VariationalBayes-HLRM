\name{VariationalBayesHLRM-package}
\alias{VariationalBayesHLRM-package}
\alias{VariationalBayesHLRM}
\docType{package}
\title{Bayesian Linear, Hierarchical, and Clustered Regression}
\description{
Fits LRM, HLRM, and CHLRM models with MCMC, CAVI, or SVI through one typed
interface. The package separates inference, simulation, posterior prediction,
model adequacy checks, and out-of-sample predictive evaluation.
}
\details{
The primary entry point is \code{fit_model()}. Model, prior, initialization,
algorithm control, and optional scaling are declared explicitly before fitting.
See the repository API contract for the complete versioned result schemas.
}
\keyword{package}
